# Preserve the supplied working installation and archival originals outside Git.
/Game Assets/
/References/

# Local/generated reverse-engineering material. Keep the directory policy file.
/artifacts/*
!/artifacts/README.md
/analysis/
/captures/
/dumps/
/extracted/
/scratch/
/tmp/
/temp/

